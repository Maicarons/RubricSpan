# ============================================================
# RubricSpan 阅微 · 环境变量模板
# 用法：复制为 .env 并填写实际值（.env 已被 git 忽略，不会入库）
#   PowerShell:  Copy-Item .env.example .env
# ============================================================

# ---------- 大模型（OpenAI 兼容接口） ----------
# 用途：① 离线打标流水线（M1）② 标准答案结构化解析（M4）
# 任何兼容 OpenAI Chat Completions 协议的服务均可（混元 / DeepSeek / Qwen / OpenAI 等）
#
# 常见服务地址（以 /v1 结尾，不含 /chat/completions）：
#   OpenAI 官方:      https://api.openai.com/v1
#   DeepSeek:         https://api.deepseek.com/v1
#   阿里百炼(通义):   https://dashscope.aliyuncs.com/compatible-mode/v1
#   硅基流动:         https://api.siliconflow.cn/v1
#
# ===== 方式 A：多端点 fallback 队列（M1 打标流水线推荐）=====
# 按 LLM_ENDPOINT_<n>_{BASE_URL,API_KEY,MODEL} 编号配置多个接入，n 升序 = 调用
# 优先级：每次调用都从 1 号端点开始；某端点整轮重试耗尽后自动切换到下一个，
# 全部端点失败才算该次调用失败（样本进重试队列）。无冷却机制——1 号端点恢复
# 后，下一次调用立即回到它。
# 可选 LLM_ENDPOINT_<n>_NAME 指定显示名（默认 ep<n>）。
# 注意：只要配置了任意编号端点，下方 OPENAI_* 单端点变量组即被忽略。
# 使用方法：取消注释并填入实际值，编号必须从 1 开始连续递增。
#
# LLM_ENDPOINT_1_NAME=fiblab
# LLM_ENDPOINT_1_BASE_URL=https://your-primary-endpoint/v1
# LLM_ENDPOINT_1_API_KEY=sk-your-primary-key
# LLM_ENDPOINT_1_MODEL=deepseek-v4-flash-0731
#
# LLM_ENDPOINT_2_NAME=siliconflow
# LLM_ENDPOINT_2_BASE_URL=https://api.siliconflow.cn/v1
# LLM_ENDPOINT_2_API_KEY=sk-your-backup-key
# LLM_ENDPOINT_2_MODEL=Qwen/Qwen3-32B
#
# LLM_ENDPOINT_3_NAME=deepseek
# LLM_ENDPOINT_3_BASE_URL=https://api.deepseek.com/v1
# LLM_ENDPOINT_3_API_KEY=sk-your-backup-key-2
# LLM_ENDPOINT_3_MODEL=deepseek-chat
#
# ===== 方式 B：单端点（旧格式，向后兼容；未配置任何编号端点时生效）=====
OPENAI_BASE_URL=https://api.openai.com/v1

# API Key（必填；切勿提交到版本库）
OPENAI_API_KEY=sk-your-api-key-here

# 打标模型（用于训练数据打标，建议选指令遵循能力强的模型）
LABELING_MODEL=gpt-4o-mini

# 标准答案解析模型（可与打标模型相同）
PARSE_MODEL=gpt-4o-mini

# 打标自一致性投票次数（高价值样本的多温度调用次数，默认 1 表示关闭）
LABELING_SELF_CONSISTENCY_VOTES=1

# 请求超时（秒；多端点模式下全端点共享）
LLM_TIMEOUT_SECS=120

# ---------- 后端服务 ----------
# 监听地址（host:port）
SERVER_LISTEN=127.0.0.1:8080

# ---------- 数据库（存储后端） ----------
# 存储后端：sqlite（默认，单机）/ mysql（生产）/ memory（临时，重启失忆）
# 优先级：命令行 --storage > 本变量 > 默认 sqlite
RUBRICSPAN_STORAGE=sqlite

# SQLite 库文件（--storage sqlite）或 Memory JSON 落盘路径（--storage memory）
# 优先级：命令行 --store > 本变量 > 默认 ../data/store.db
RUBRICSPAN_STORE=../data/store.db

# MySQL 连接串（RUBRICSPAN_STORAGE=mysql 时必填）
# 优先级：--db-url > RUBRICSPAN_DB_URL > DATABASE_URL
# RUBRICSPAN_DB_URL=mysql://user:pass@127.0.0.1:3306/rubricspan

# 评分配置目录（教师确认后的评分配置 JSON 落盘位置）
SCORING_CONFIGS_DIR=../data/scoring_configs

# ---------- 模型与产物 ----------
# 模型产物目录（见 contracts/model-artifacts.md）
MODELS_DIR=../models

# 推理设备：cuda / cpu（RTX 4060 建议 cuda）
INFERENCE_DEVICE=cuda

# ---------- 前端 ----------
# 前端连接的后端地址（构建时注入：NEXT_PUBLIC_ 前缀变量会打包进浏览器产物）
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8080

# ---------- 推理模型精度档 ----------
# fp32（默认，对拍验收档）/ int8（体积与速度均衡）/ fp16（GPU Ada+ 最快，非对拍档）
# fp16 产物由 scripts/export_fp16.py 生成；数值与 fp32 有 ~1e-3 偏差，生产前先跑
# `cargo run -p rubricspan-inference --bin parity_check -- --precision fp16` 核对
RUBRICSPAN_MODEL_PRECISION=fp32

# ---------- OCR ----------
# OCR 推理设备：cuda / cpu
OCR_DEVICE=cuda

# 单行识别低置信阈值（低于该值标记"识别存疑"，供教师核对）
OCR_LOW_CONFIDENCE_THRESHOLD=0.80
