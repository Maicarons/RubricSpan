# ============================================================
# RubricSpan .gitignore
# 原则：代码与契约入库；数据、模型产物、依赖、构建产物、密钥不入库
# ============================================================

# ---------- 大文件：数据与模型产物 ----------
# 仓库根的训练中间产物与基座权重（1.6GB+，绝不入库；已发布到 HF/ModelScope 厂库）
artifacts/
backbone/

# 数据与模型只保留各目录内的 README / .gitkeep / 模板文件
data/raw/**
data/synthetic/**
data/processed/**
data/labeling_cache/**
data/scoring_configs/**
!data/**/README.md
!data/**/.gitkeep
!data/**/*.example
!data/**/*.example.json
!data/**/*.template
# 外部补充数据集目录：仅 README 入库（数据本身不入库）
!data/raw/extra_sources/
!data/raw/extra_sources/README.md

models/artifacts/**
models/int8/**
models/backbone/**
models/mrc/tokenizer/**
models/similarity/tokenizer/**
models/wasm/tokenizer/**
models/**/*.onnx
models/**/*.onnx_data
models/**/*.bin
models/**/*.ggml
models/**/*.gguf
models/**/*.pt
models/**/*.pth
models/**/*.safetensors
models/**/*.vocab
!models/README.md
!models/**/.gitkeep

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.ipynb_checkpoints/

# ---------- Rust ----------
target/
Cargo.lock.backup

# ---------- Node / Next.js ----------
node_modules/
docs/.vitepress/cache/
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/
frontend/.vercel/
*.tsbuildinfo
next-env.d.ts

# ---------- WASM 构建产物 ----------
wasm/pkg/
wasm/target/
wasm/dist/
*.wasm
# M6：前端静态资产由 scripts/m6_wasm_build.sh 再生（含数百 MB 模型，绝不入库）
frontend/public/wasm/
.playwright-mcp/

# ---------- 数据库与本地运行时文件 ----------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# 后端 JSON 存储的运行时状态（服务启动再生）
data/store.json
# 运行时评分参数（管理后台可调，持久化于 store 目录，服务启动再生）
data/scoring_settings.json
# 运行时备份文件（如 store.json.m8bak 等）
data/store.json.*

# ---------- 密钥与环境配置（绝不入库） ----------
.env
.env.*
!.env.example

# ---------- OCR / 临时上传 ----------
uploads/
tmp/
temp/
*.tmp

# ---------- IDE 与编辑器 ----------
.idea/
*.iml
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
*.log
logs/

# ---------- WorkBuddy 本地记忆（不入版本库） ----------
.workbuddy/

# OCR 模型产物（RapidOCR PP-OCRv6，首次启动自动从 ModelScope 下载）
models/ocr/**
!models/ocr/README.md

# ---------- 本地代理/助手工作区 ----------
.zcode/
.commandcode/

# ---------- Mimosa 安全扫描工作区 ----------
.mimosa/

# ---------- 前端静态导出产物（由 Rust fallback 托管 / CI 构建生成） ----------
/frontend/out/
/frontend-admin/out/
/frontend-admin/.next/

# ---------- 论文稿（本地撰写，不入库） ----------
paper/
